{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/bio",
      "destination": "/links",
      "permanent": false
    },
    {
      "source": "/link",
      "destination": "/links",
      "permanent": false
    },
    {
      "source": "/linktree",
      "destination": "/links",
      "permanent": false
    }
  ]
}